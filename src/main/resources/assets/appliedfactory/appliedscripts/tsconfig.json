{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2022"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "applied_factory.d.ts"]
}
